{
  "name": "trace-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "check:public": "node scripts/check-public-surface.mjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run check:brb-data && npm run check:public && npm run build && npm run check:export && npm run check:release",
    "check:export": "node scripts/check-export.mjs",
    "check:release": "node scripts/check-release-surface.mjs",
    "check:brb-data": "node scripts/build-br-b-heldout.mjs --check"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.8",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
